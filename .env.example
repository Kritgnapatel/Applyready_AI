# ApplyReady AI — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to source control.

# ── Backend ──────────────────────────────────────────────────────────────────
PORT=5000

# URL of the Python FastAPI ML service
ML_SERVICE_URL=http://127.0.0.1:8000

# Comma-separated list of allowed frontend origins for CORS
# For local development: http://127.0.0.1:5500,null
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,null

# ── MongoDB Atlas ─────────────────────────────────────────────────────────────
# Optional. If not set, the backend runs in stateless mode (no persistence).
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=

# ── Authentication ────────────────────────────────────────────────────────────
# Optional. Required for Google Sign-In with Google Identity Services.
GOOGLE_CLIENT_ID=
# Optional. Secret for signing session JWTs if used.
JWT_SECRET=

# ── Gemini API (optional GenAI explanations) ──────────────────────────────────
# Optional. If not set, AI explanations are disabled and a fallback message is shown.
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
